#!/bin/sh
# SPDX-FileCopyrightText: 2026 The MCUHome Contributors
# SPDX-License-Identifier: Apache-2.0
#
# The program of the build container contract (docs/design/
# build-container-contract.md §2.2). The image installs this file at the
# fixed absolute path /mcuhome/run, mode 0755, and a backend invokes it as
#
#     /mcuhome/run <action> <absolute path of the request document>
#
# Everything it does is call mcuhome.compiler.abi.main() with that argv.
# The ABI — argv, the request document, the exit codes, the result
# document — lives there and not here, because the `subprocess` profile
# (§1.2) runs the same code with no image and no launcher around it.
#
# No extension, because §2.2 says so: a third party may ship a compiled
# binary at this path and `.sh` would then be a lie. /bin/sh rather than a
# python shebang, because the two things this file has to know are the
# interpreter and where the SDK is mounted, and a shebang can only carry
# the first.
#
# The invocation is resolved without a shell (§2.2), so nothing here may
# depend on PATH. Both paths below are the image's own, fixed by
# containers/build-container/Dockerfile:
#
#   /opt/venv                the image's Python environment
#   /mcuhome/workspace/mcuhome
#       the west manifest repository's directory in the baked workspace,
#       which is where ADR 0018's hash-pinned SDK package is mounted per
#       session. The mcuhome Python package sits inside it, so this is a
#       PYTHONPATH entry and not a module path.

set -eu

INTERPRETER=/opt/venv/bin/python3
SDK=/mcuhome/workspace/mcuhome-sdk

# Exit 70 and not 1: exit 1 promises a result document (§5.3), and there
# is no program here to write one. The contract leaves every code outside
# {0, 1, 66} as "the program died. Undefined forever.", which is exactly
# what this is — the SDK the program lives in was never mounted. Saying so
# on stderr is worth more than a Python traceback about an import.
if [ ! -f "$SDK/mcuhome/compiler/abi.py" ]; then
    echo "/mcuhome/run: no MCUHome SDK at $SDK — the backend did not mount it" >&2
    exit 70
fi

PYTHONPATH="$SDK${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec "$INTERPRETER" -m mcuhome.compiler.abi "$@"
