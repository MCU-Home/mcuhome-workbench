     // Copy the public key from the CSR
@@ -74,6 +91,7 @@ CHIP_ERROR VerifyCertificateSigningRequest(const uint8_t * csr_buf, size_t csr_l
 
     VerifyOrExit(result == 0, error = CHIP_ERROR_INTERNAL);
     VerifyOrExit(pubkey_size == pubkey.Length(), error = CHIP_ERROR_INTERNAL);
+#endif
 
     // Convert DER signature to raw signature
     error = EcdsaAsn1SignatureToRaw(kP256_FE_Length,
@@ -507,14 +525,32 @@ CHIP_ERROR ExtractPubkeyFromX509Cert(const ByteSpan & certificate, Crypto::P256P
 #if defined(MBEDTLS_X509_CRT_PARSE_C)
     CHIP_ERROR error = CHIP_NO_ERROR;
     mbedtls_x509_crt mbed_cert;
+#if MBEDTLS_VERSION_MAJOR < 4
     mbedtls_ecp_keypair * keypair = nullptr;
-    size_t pubkey_size            = 0;
+#endif
+    size_t pubkey_size = 0;
 
     mbedtls_x509_crt_init(&mbed_cert);
 
     int result = mbedtls_x509_crt_parse(&mbed_cert, Uint8::to_const_uchar(certificate.data()), certificate.size());
     VerifyOrExit(result == 0, error = CHIP_ERROR_INTERNAL);
 
+#if MBEDTLS_VERSION_MAJOR >= 4
+    // MCUHome prototype patch: mbedTLS 4 removed mbedtls_pk_get_type()/
+    // mbedtls_pk_ec(). Extract the raw point from the SubjectPublicKeyInfo
+    // DER encoding instead; the 65-byte uncompressed-point check covers
+    // the previous key-type/group validation for P-256.
+    {
+        unsigned char der[128];
+        result = mbedtls_pk_write_pubkey_der(&mbed_cert.CHIP_CRYPTO_PAL_PRIVATE_X509(pk), der, sizeof(der));
+        VerifyOrExit(result >= static_cast<int>(pubkey.Length()), error = CHIP_ERROR_INVALID_ARGUMENT);
+        const unsigned char * point = der + sizeof(der) - pubkey.Length();
+        VerifyOrExit(point[0] == 0x04, error = CHIP_ERROR_INVALID_ARGUMENT);
+        memcpy(Uint8::to_uchar(pubkey.Bytes()), point, pubkey.Length());
+        pubkey_size = pubkey.Length();
+        result      = 0;
+    }
+#else
     VerifyOrExit(mbedtls_pk_get_type(&(mbed_cert.CHIP_CRYPTO_PAL_PRIVATE_X509(pk))) == MBEDTLS_PK_ECKEY,
                  error = CHIP_ERROR_INVALID_ARGUMENT);
 
@@ -527,6 +563,7 @@ CHIP_ERROR ExtractPubkeyFromX509Cert(const ByteSpan & certificate, Crypto::P256P
 
     VerifyOrExit(result == 0, error = CHIP_ERROR_INTERNAL);
     VerifyOrExit(pubkey_size == pubkey.Length(), error = CHIP_ERROR_INTERNAL);
+#endif
 
 exit:
     _log_mbedTLS_error(result);
