@@ -0,0 +1,3 @@
+# Stub generated by the MCUHome prototype: normally written by CHIP's
+# pigweed bootstrap. Empty is sufficient for Zephyr-toolchain builds
+# (pw_env_setup_* variables are only required for pigweed-clang hosts).
diff --git a/config/zephyr/chip-gn/args.gni b/config/zephyr/chip-gn/args.gni
index f49cfb708e..7f0b5bc9f5 100644
--- a/config/zephyr/chip-gn/args.gni
+++ b/config/zephyr/chip-gn/args.gni
@@ -30,3 +30,7 @@ chip_external_mbedtls = true
 custom_toolchain = "${chip_root}/config/zephyr/chip-gn/toolchain:zephyr"
 
 pw_build_PIP_CONSTRAINTS = [ "${chip_root}/scripts/setup/constraints.txt" ]
+
+# MCUHome prototype: Zephyr 4.4 ships mbedTLS 4 (PSA-only crypto API) —
+# the legacy mbedtls PAL cannot compile against it. Use the PSA PAL.
+chip_crypto = "psa"
diff --git a/config/zephyr/chip-module/CMakeLists.txt b/config/zephyr/chip-module/CMakeLists.txt
index 8f303a9df9..2b5fc1621b 100644
--- a/config/zephyr/chip-module/CMakeLists.txt
+++ b/config/zephyr/chip-module/CMakeLists.txt
@@ -58,6 +58,33 @@ if(CONFIG_CHIP)
     zephyr_get_compile_flags(ZEPHYR_CFLAGS_CC CXX)
     matter_add_cxxflags("${ZEPHYR_CFLAGS_CC}")
     zephyr_get_gnu_cpp_standard(ZEPHYR_GNU_CPP_STD)
+
+    # --- MCUHome prototype patch: vanilla Zephyr 4.4 integration ---------
+    get_filename_component(MCUHOME_WS ${ZEPHYR_BASE}/.. REALPATH)
+    # 1) Zephyr builds mbedTLS 4 / tf-psa-crypto with generated config
+    #    headers; the CHIP compile must see the same configuration, plus
+    #    the builtin-driver private headers and legacy-header shims.
+    if(CONFIG_MBEDTLS)
+        matter_add_flags(-I${ZEPHYR_BASE}/modules/mbedtls/configs)
+        matter_add_flags(-I${MCUHOME_WS}/modules/crypto/mbedtls/include)
+        matter_add_flags(-I${MCUHOME_WS}/modules/crypto/tf-psa-crypto/include)
+        matter_add_flags(-I${MCUHOME_WS}/modules/crypto/tf-psa-crypto/drivers/builtin/include)
+        matter_add_flags(-I${MCUHOME_WS}/.tools/mbedtls-compat)
+        matter_add_flags("-DMBEDTLS_CONFIG_FILE=\"config-mbedtls.h\"")
+        matter_add_flags("-DTF_PSA_CRYPTO_CONFIG_FILE=\"config-tf-psa-crypto.h\"")
+        # tf-psa-crypto hides its legacy/builtin declarations behind this
+        # marker; CHIP's Spake2p ECP math needs them.
+        matter_add_flags(-DMBEDTLS_DECLARE_PRIVATE_IDENTIFIERS)
+    endif()
+    # 2) hal_nordic's 802.15.4 driver headers are attached to its own
+    #    library target, not to zephyr_interface, so the captured flags
+    #    miss them.
+    if(CONFIG_NRF_802154_RADIO_DRIVER)
+        foreach(subdir driver/include common/include sl/include sl/sl_opensource/include)
+            matter_add_flags(-I${MCUHOME_WS}/modules/hal/nordic/drivers/nrf_802154/${subdir})
+        endforeach()
+    endif()
+    # ---------------------------------------------------------------------
     matter_add_cxxflags("${ZEPHYR_GNU_CPP_STD}")
 
     # Set up custom OpenThread configuration
