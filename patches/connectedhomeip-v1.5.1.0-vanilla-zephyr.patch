+        VerifyOrExit(result >= static_cast<int>(pubkey.Length()), error = CHIP_ERROR_INTERNAL);
+        const unsigned char * point = der + sizeof(der) - pubkey.Length();
+        VerifyOrExit(point[0] == 0x04, error = CHIP_ERROR_INTERNAL);
