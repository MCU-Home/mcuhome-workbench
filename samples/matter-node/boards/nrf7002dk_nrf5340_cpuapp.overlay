/* Entropy: the nRF5340 application core has no RNG peripheral. The board
 * default points `zephyr,entropy` at the Bluetooth HCI entropy driver
 * (`&rng_hci`, see dts/arm/nordic/nrf5340_cpuapp.dtsi), which is dead
 * weight here — this node is Thread-only and Bluetooth is off (ADR
 * 0011). Redirect to the IPC driver, which seeds a CTR-DRBG from the
 * network core's real RNG over a second endpoint on `ipc0` — the same
 * instance the 802.15.4 spinel channel already uses. The network core
 * must run mcuhome/samples/netcore-radio for this to bind.
 */
/ {
	netcore_entropy: netcore-entropy {
		compatible = "mcuhome,entropy-ipc";
		ipc = <&ipc0>;
		status = "okay";
	};

	chosen {
		zephyr,entropy = &netcore_entropy;
	};

	/* Watchdog: ADR 0015's health amendment makes one mandatory for every
	 * application image, and lib/health/ finds it through the watchdog0
	 * alias — the Zephyr convention, which this board's own devicetree
	 * does not define even though the SoC has the peripheral. Board
	 * wiring, exactly like the entropy redirection above, and exactly
	 * what mcuhome/registry.py emits into a generated application's
	 * overlay. Without it the build stops and names the alias.
	 */
	aliases {
		watchdog0 = &wdt0;
	};
};

/* Bosch BMP180 on the DK's Arduino-header I2C bus.
 *
 * The node label is `baro`, not `bmp180`, because that is the peripheral's
 * name in the device configuration this sample mirrors
 * (docs/design/examples/00-bmp180-two-endpoints.yaml, hardware.peripherals)
 * and therefore the label the generated tables reference. This block is
 * exactly what the builder's overlay generator emits; the entropy node
 * above is board wiring the generator does not own.
 *
 * `arduino_i2c` is the board's own label for i2c1
 * (zephyr/boards/nordic/nrf7002dk/nrf5340_cpuapp_common.dtsi); the
 * i2c1_default pinctrl group puts TWIM_SDA on P1.02 and TWIM_SCL on P1.03,
 * which the board's arduino_header gpio-map exposes as D14 and D15 — the
 * dedicated SDA/SCL pins of the Arduino UNO R3 shield header. A4/A5 are
 * NOT on this bus on the nRF7002-DK: they map to P0.25/P0.26 and are plain
 * GPIO/ADC inputs. The physical wiring is spelled out in the sample README.
 *
 * The BMP180's I2C address is fixed at 0x77 in silicon — the chip has no
 * address-select pin, so this is the only possible reg value.
 *
 * osr-press = 1 ("standard", 2 samples, ~7.5 ms conversion). The datasheet
 * quotes ~0.06 hPa RMS noise even in ultra-low-power mode, an order of
 * magnitude below this endpoint's 1 hPa quantization, so the higher
 * oversampling modes would buy resolution the Matter attribute cannot
 * carry and pay for it in conversion time — which on a sleepy end device
 * is radio-off time spent awake.
 */
&arduino_i2c {
	status = "okay";

	baro: baro@77 {
		compatible = "bosch,bmp180";
		reg = <0x77>;
		osr-press = <1>;
		status = "okay";
	};
};
