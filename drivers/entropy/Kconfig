config MCUHOME_ALLOW_INSECURE_ENTROPY
	bool "I understand this build has NO secure randomness (DEVELOPMENT ONLY)"
	help
	  Explicit opt-in gate for the insecure prototype PRNG. Never set
	  this outside local development: all keys the device generates
	  (commissioning sessions, SRP signatures) become predictable.

config MCUHOME_PROTO_ENTROPY
	bool "Insecure prototype entropy driver (nRF5340 appcore experiment)"
	default y if DT_HAS_MCUHOME_PROTO_ENTROPY_ENABLED
	depends on ENTROPY_GENERATOR
	depends on MCUHOME_ALLOW_INSECURE_ENTROPY
	select ENTROPY_HAS_DRIVER
